{
    "version": "0.2",
    "sections": [
        {
            "name": "General",
            "fields": [
                {
                    "name": "equations",
                    "type": "str",
                    "selectables": ["euler", "shallow_water"]
                },
                {
                    "name": "depth_approx",
                    "type": "str",
                    "selectables": ["deep", "shallow"],
                    "default": "deep",
                    "dependency": {
                        "name": "equations",
                        "values": ["euler"]
                    }
                },
                {
                    "name": "initial_condition",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "time_start",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "time_end",
                    "type": "str",
                    "default": ""
                }
            ]
        },
        {
            "name": "System",
            "fields": [
                {
                    "name": "desired_device",
                    "type": "str",
                    "selectables": ["cpp", "cuda", "cupy", "numpy", "omp", "torch"],
                    "default": "cpp",
                    "description": "Physical backend to run the computation on"
                },
                {
                    "name": "cuda_devices",
                    "type": "list-int",
                    "default": [],
                    "dependency": {
                        "name": "desired_device",
                        "values": ["cuda", "cupy"]
                    },
                    "description": "List of Nvidia physical devices to use"
                },
                {
                    "name": "matmul_backend",
                    "type": "str",
                    "selectables": ["default", "nvmath"],
                    "default": "default",
                    "description": "Backend for matrix multiplication operations (default uses numpy/cupy, nvmath uses nvmath-python)"
                }
            ]
        },
        {
            "name": "Test_case",
            "fields": [
                {
                    "name": "topography_file",
                    "type": "str",
                    "dependency":{
                        "name": "case_number",
                        "values": [-1]
                    }
                },
                {
                    "name": "initial_conditions_file",
                    "type": "str",
                    "dependency":{
                        "name": "case_number",
                        "values": [-1]
                    }
                },
                {
                    "name": "case_number",
                    "type": "int",
                    "default": -1
                },
                {
                    "name": "matsuno_wave_type",
                    "type": "str",
                    "dependency": {
                        "name": "case_number",
                        "values": [9]
                    }
                },
                {
                    "name": "matsuno_amp",
                    "type": "float",
                    "dependency": {
                        "name": "case_number",
                        "values": [9]
                    }
                },
                {
                    "name": "bubble_theta",
                    "type": "float",
                    "default": 0.0,
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian2d"]
                    }
                },
                {
                    "name": "bubble_rad",
                    "type": "float",
                    "default": 0.0
                }
            ]
        },
        {
            "name": "Time_integration",
            "fields": [
                {
                    "name": "dt",
                    "type": "float",
                    "min": 0.0
                },
                {
                    "name": "t_end",
                    "type": "float"
                },
                {
                    "name": "time_integrator",
                    "type": "str"
                },
                {
                    "name": "tolerance",
                    "type": "float"
                },
                {
                    "name": "starting_step",
                    "type": "int",
                    "default": 0
                },
                {
                    "name": "exponential_solver",
                    "type": "str",
                    "default": "pmex",
                    "selectables": ["pmex", "pmex_ne", "kiops", "exode"]
                },
                {
                    "name": "exode_method",
                    "type": "str",
                    "default": "BS3(2)",
                    "selectables": [ "BS3(2)", "DP5(4)", "M4(3)", "KC3(2)", "EXLRK3(2)", "EXLRK4(3)", "F14(12)", "DP8(7)", "F10(8)" ]
                },
                {
                    "name": "exode_controller",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "krylov_size",
                    "type": "int",
                    "default": 1,
                    "min": 0
                },
                {
                    "name": "krylov_mmax",
                    "type": "int",
                    "default": 64,
                    "min": 1,
                    "description": "Largest Krylov subspace the exponential solver may build. The solver stores mmax+1 basis vectors of the full state, so this caps its memory; lowering it trades memory for more internal substeps."
                },
                {
                    "name": "jacobian_method",
                    "type": "str",
                    "default": "complex",
                    "selectables": ["complex", "fd"]
                },
                {
                    "name": "verbose_solver",
                    "type": "int",
                    "default": 0
                },
                {
                    "name": "gmres_restart",
                    "type": "int",
                    "default": 20,
                    "min": 1
                },
                {
                    "name": "splitting_integrator_1",
                    "type": "str",
                    "default": "",
                    "dependancy": {
                        "name": "time_integrator",
                        "values": ["lie", "strang"]
                    }
                },
                {
                    "name": "splitting_integrator_2",
                    "type": "str",
                    "default": "",
                    "dependancy": {
                        "name": "time_integrator",
                        "values": ["lie", "strang"]
                    }
                }
            ]
        },
        {
            "name": "Spatial_discretization",
            "fields": [
                {
                    "name": "num_solpts",
                    "type": "int",
                    "min": 1,
                    "dependency":{
                        "name": "grid_file",
                        "values": [""]
                    }
                },
                {
                    "name": "num_elements_horizontal",
                    "type": "int",
                    "min": 1,
                    "dependency": {
                        "name": "grid_file",
                        "values": [""]
                    }
                },
                {
                    "name": "num_elements_vertical",
                    "type": "int",
                    "min": 1,
                    "default": 1
                },
                {
                    "name": "filter_apply",
                    "type": "bool",
                    "default": false
                },
                {
                    "name": "filter_order",
                    "type": "int",
                    "default": 16,
                    "dependency": {
                        "name": "filter_apply",
                        "values": [true]
                    }
                },
                {
                    "name": "filter_cutoff",
                    "type": "float",
                    "default": 0.25,
                    "dependency": {
                        "name": "filter_apply",
                        "values": [true]
                    }
                },
                {
                    "name": "expfilter_apply",
                    "type": "bool",
                    "default": false
                },
                {
                    "name": "expfilter_order",
                    "type": "int",
                    "dependency": {
                        "name": "expfilter_apply",
                        "values": [true]
                    }
                },
                {
                    "name": "expfilter_cutoff",
                    "type": "float",
                    "dependency": {
                        "name": "expfilter_apply",
                        "values": [true]
                    }
                },
                {
                    "name": "expfilter_strength",
                    "type": "float",
                    "dependency": {
                        "name": "expfilter_apply",
                        "values": [true]
                    }
                },
                {
                    "name": "apply_sponge",
                    "type": "bool",
                    "default": false
                },
                {
                    "name": "sponge_tscale",
                    "type": "float",
                    "default": 1.0,
                    "dependency": {
                        "name": "apply_sponge",
                        "values": [true]
                    }
                },
                {
                    "name": "sponge_zscale",
                    "type": "float",
                    "default": 0.0,
                    "dependency": {
                        "name": "apply_sponge",
                        "values": [true]
                    }
                }
            ]
        },
        {
            "name": "Grid",
            "fields": [
                {
                    "name": "grid_file",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "grid_type",
                    "type": "str",
                    "selectables": ["cubed_sphere", "cartesian2d"],
                    "dependency":{
                        "name": "grid_file",
                        "values": [""]
                    }
                },
                {
                    "name": "discretization",
                    "type": "str",
                    "default": "dg",
                    "selectables": ["dg", "fv"]
                },
                {
                    "name": "lambda0",
                    "type": "angle24",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    },
                    "description": "Longitude in radians of the central point of panel 0"
                },
                {
                    "name": "phi0",
                    "type": "angle24",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    },
                    "description": "Latitude in radians of the central point of panel 0"
                },
                {
                    "name": "alpha0",
                    "type": "angle24",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    },
                    "description": "Rotation in radians of the central meridian of panel 0"
                },
                {
                    "name": "ztop",
                    "type": "float",
                    "default": 0.0,
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    }
                },
                {
                    "name": "x0",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian2d"]
                    }
                },
                {
                    "name": "x1",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian2d"]
                    }
                },
                {
                    "name": "z0",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian2d"]
                    }
                },
                {
                    "name": "z1",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian2d"]
                    }
                }
           ]
        },
        {
            "name": "Preconditioning",
            "fields": [
                {
                    "name": "preconditioner",
                    "type": "str",
                    "default": "none",
                    "selectables": ["none"]
                },
                {
                    "name": "kiops_dt_factor",
                    "type": "float",
                    "default": 1.1,
                    "dependency": {
                        "name": "mg_smoother",
                        "values": ["kiops"]
                    }
                },
                {
                    "name": "verbose_precond",
                    "type": "int",
                    "default": 0}
            ]
        },
        {
            "name": "Output_options",
            "fields": [
                {
                    "name": "stat_freq",
                    "type": "int",
                    "default": 0,
                    "description": "Frequency in timesteps at which to print block stats"
                },
                {
                    "name": "output_freq",
                    "type": "int",
                    "default": 0,
                    "description": "Frequency in timesteps at which to store the solution"
                },
                {
                    "name": "save_state_freq",
                    "type": "int",
                    "default": 0,
                    "description": "Frequency in timesteps at which to save the state vector"
                },
                {
                    "name": "output_dir",
                    "type": "case-sensitive-str",
                    "default": "results",
                    "description": "Directory where to store all the output"
                },
                {
                    "name": "base_output_file",
                    "type": "case-sensitive-str",
                    "default": "out",
                    "description": "Name of file where to store the solution"
                },
                {
                    "name": "store_total_time",
                    "type": "bool",
                    "default": false,
                    "description": "Whether to output total runtime in seconds to a file"
                },
                {
                    "name": "output_format",
                    "type": "str",
                    "default": "netcdf",
                    "selectables": ["netcdf", "fst"],
                    "description": "Desired format to use for storing simulation results."
                },
                {
                    "name": "netcdf_use_collective",
                    "type": "bool",
                    "default": true,
                    "description": "Enable NetCDF collective I/O operations (requires parallel NetCDF support)"
                }
                
            ]
        },
        {
            "name": "Post_processing",
            "fields": [
                {
                    "name": "enable_schar_mountain",
                    "type": "bool",
                    "default": false,
                    "description": "Enable Schar wave mountains to grow (stabilisation issue)"
                },
                {
                    "name": "schar_mountain_longitude",
                    "type": "float",
                    "description": "Mountain longitude center point (radians)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_lattitude",
                    "type": "float",
                    "description": "Mountain latitude center point (radians)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_height",
                    "type": "float",
                    "description": "Peak height of the mountain range (m)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_radius",
                    "type": "float",
                    "description": "Mountain radius (meters)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_length",
                    "type": "float",
                    "description": "Mountain wavelength (meters)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_step",
                    "type": "int",
                    "min": 0,
                    "default": 0,
                    "description": "Number of step of interpolation, 0 is instantaneous",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                }
            ]
        }
    ]
}
