{
    "version": "0.2",
    "sections": [
        {
            "name": "General",
            "fields": [
                {
                    "name": "equations",
                    "type": "str",
                    "selectables": ["euler", "shallow_water"]
                },
                {
                    "name": "depth_approx",
                    "type": "str",
                    "selectables": ["deep", "shallow"],
                    "default": "deep",
                    "dependency": {
                        "name": "equations",
                        "values": ["euler"]
                    }
                },
                {
                    "name": "precision",
                    "type": "str",
                    "selectables": ["double", "single"],
                    "default": "double",
                    "description": "Floating-point precision of the whole computation. Single precision halves the memory footprint and bandwidth (letting finer resolutions fit on a GPU), at the cost of accuracy"
                },
                {
                    "name": "initial_condition",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "time_start",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "time_end",
                    "type": "str",
                    "default": ""
                }
            ]
        },
        {
            "name": "System",
            "fields": [
                {
                    "name": "pytorch_device",
                    "type": "str",
                    "selectables": ["cuda", "cpu"],
                    "default": "cuda",
                    "description": "Where the computation puts its tensors. Falls back to the CPU if no GPU is available"
                }
            ]
        },
        {
            "name": "Test_case",
            "fields": [
                {
                    "name": "topography_file",
                    "type": "str",
                    "dependency":{
                        "name": "case_number",
                        "values": [-1]
                    }
                },
                {
                    "name": "initial_conditions_file",
                    "type": "str",
                    "dependency":{
                        "name": "case_number",
                        "values": [-1]
                    }
                },
                {
                    "name": "case_number",
                    "type": "int",
                    "default": -1
                },
                {
                    "name": "matsuno_wave_type",
                    "type": "str",
                    "dependency": {
                        "name": "case_number",
                        "values": [9]
                    }
                },
                {
                    "name": "matsuno_amp",
                    "type": "float",
                    "dependency": {
                        "name": "case_number",
                        "values": [9]
                    }
                },
                {
                    "name": "bubble_theta",
                    "type": "float",
                    "default": 0.0,
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian3d"]
                    }
                },
                {
                    "name": "bubble_rad",
                    "type": "float",
                    "default": 0.0
                }
            ]
        },
        {
            "name": "Time_integration",
            "fields": [
                {
                    "name": "dt",
                    "type": "float",
                    "min": 0.0
                },
                {
                    "name": "t_end",
                    "type": "float"
                },
                {
                    "name": "time_integrator",
                    "type": "str"
                },
                {
                    "name": "tolerance",
                    "type": "float",
                    "default": 1e-7,
                    "description": "Convergence tolerance of the implicit / exponential integrators' inner solver. Ignored by the explicit integrators (e.g. tvdrk3), which have no inner solve."
                },
                {
                    "name": "starting_step",
                    "type": "int",
                    "default": 0
                },
                {
                    "name": "exponential_solver",
                    "type": "str",
                    "default": "pmex",
                    "selectables": ["pmex", "pmex_ne", "kiops", "exode"]
                },
                {
                    "name": "exode_method",
                    "type": "str",
                    "default": "BS3(2)",
                    "selectables": [ "BS3(2)", "DP5(4)", "M4(3)", "KC3(2)", "EXLRK3(2)", "EXLRK4(3)", "F14(12)", "DP8(7)", "F10(8)" ]
                },
                {
                    "name": "exode_controller",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "krylov_size",
                    "type": "int",
                    "default": 1,
                    "min": 0
                },
                {
                    "name": "krylov_mmax",
                    "type": "int",
                    "default": 64,
                    "min": 1,
                    "description": "Largest Krylov subspace the exponential solver may build. The solver stores mmax+1 basis vectors of the full state, so this caps its memory; lowering it trades memory for more internal substeps."
                },
                {
                    "name": "jacobian_method",
                    "type": "str",
                    "default": "complex",
                    "selectables": ["complex", "fd"]
                },
                {
                    "name": "verbose_solver",
                    "type": "int",
                    "default": 0
                },
                {
                    "name": "gmres_restart",
                    "type": "int",
                    "default": 20,
                    "min": 1
                },
                {
                    "name": "splitting_integrator_1",
                    "type": "str",
                    "default": "",
                    "dependancy": {
                        "name": "time_integrator",
                        "values": ["lie", "strang"]
                    }
                },
                {
                    "name": "splitting_integrator_2",
                    "type": "str",
                    "default": "",
                    "dependancy": {
                        "name": "time_integrator",
                        "values": ["lie", "strang"]
                    }
                }
            ]
        },
        {
            "name": "Spatial_discretization",
            "fields": [
                {
                    "name": "num_solpts",
                    "type": "int",
                    "min": 1,
                    "dependency":{
                        "name": "grid_file",
                        "values": [""]
                    }
                },
                {
                    "name": "num_elements_horizontal",
                    "type": "int",
                    "min": 1,
                    "dependency": {
                        "name": "grid_file",
                        "values": [""]
                    }
                },
                {
                    "name": "num_elements_vertical",
                    "type": "int",
                    "min": 1,
                    "default": 1
                }
            ]
        },
        {
            "name": "Grid",
            "fields": [
                {
                    "name": "grid_file",
                    "type": "str",
                    "default": ""
                },
                {
                    "name": "grid_type",
                    "type": "str",
                    "selectables": ["cubed_sphere", "cartesian3d"],
                    "dependency":{
                        "name": "grid_file",
                        "values": [""]
                    }
                },
                {
                    "name": "lateral_boundary",
                    "type": "str",
                    "selectables": ["donor_cell", "wall", "periodic"],
                    "default": "donor_cell",
                    "description": "Lateral (horizontal) boundary treatment. donor_cell exchanges traces with the neighbouring tile (the cubed sphere's inter-panel donor cell); wall reflects the tile's own boundary trace (solid wall); periodic wraps the tile to its opposite edge. The cubed sphere always uses donor_cell; wall/periodic are for cartesian grids."
                },
                {
                    "name": "discretization",
                    "type": "str",
                    "default": "dg",
                    "selectables": ["dg", "fv"]
                },
                {
                    "name": "advection_only",
                    "type": "str",
                    "default": "auto",
                    "selectables": ["auto", "on", "off"],
                    "description": "Whether the Euler dynamics are frozen and only passive advection is integrated. 'auto' derives it from the DCMIP case number (cases <= 13 are advection tests); 'on'/'off' force it. Cartesian grids are always fully dynamical."
                },
                {
                    "name": "lambda0",
                    "type": "angle24",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    },
                    "description": "Longitude in radians of the central point of panel 0"
                },
                {
                    "name": "phi0",
                    "type": "angle24",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    },
                    "description": "Latitude in radians of the central point of panel 0"
                },
                {
                    "name": "alpha0",
                    "type": "angle24",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    },
                    "description": "Rotation in radians of the central meridian of panel 0"
                },
                {
                    "name": "ztop",
                    "type": "float",
                    "default": 0.0,
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    }
                },
                {
                    "name": "vertical_coord",
                    "type": "str",
                    "selectables": ["gal_chen", "sleve"],
                    "default": "gal_chen",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cubed_sphere"]
                    },
                    "description": "Terrain-following vertical coordinate. gal_chen decays the terrain linearly with height; sleve (Schar et al. 2002) decays the large- and small-scale parts of the terrain at different rates, so that small-scale features vanish faster aloft"
                },
                {
                    "name": "sleve_scale_large",
                    "type": "float",
                    "default": 10000.0,
                    "dependency": {
                        "name": "vertical_coord",
                        "values": ["sleve"]
                    },
                    "description": "SLEVE decay scale height s1 of the large-scale topography (m)"
                },
                {
                    "name": "sleve_scale_small",
                    "type": "float",
                    "default": 2500.0,
                    "dependency": {
                        "name": "vertical_coord",
                        "values": ["sleve"]
                    },
                    "description": "SLEVE decay scale height s2 of the small-scale topography (m). Should be well below sleve_scale_large"
                },
                {
                    "name": "x0",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian3d"]
                    }
                },
                {
                    "name": "x1",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian3d"]
                    }
                },
                {
                    "name": "y0",
                    "type": "float",
                    "default": 0.0,
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian3d"]
                    }
                },
                {
                    "name": "y1",
                    "type": "float",
                    "default": 1000.0,
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian3d"]
                    }
                },
                {
                    "name": "z0",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian3d"]
                    }
                },
                {
                    "name": "z1",
                    "type": "float",
                    "dependency": {
                        "name": "grid_type",
                        "values": ["cartesian3d"]
                    }
                }
           ]
        },
        {
            "name": "Preconditioning",
            "fields": [
                {
                    "name": "preconditioner",
                    "type": "str",
                    "default": "none",
                    "selectables": ["none"]
                },
                {
                    "name": "kiops_dt_factor",
                    "type": "float",
                    "default": 1.1,
                    "dependency": {
                        "name": "mg_smoother",
                        "values": ["kiops"]
                    }
                },
                {
                    "name": "verbose_precond",
                    "type": "int",
                    "default": 0}
            ]
        },
        {
            "name": "Output_options",
            "fields": [
                {
                    "name": "stat_freq",
                    "type": "int",
                    "default": 0,
                    "description": "Frequency in timesteps at which to print block stats"
                },
                {
                    "name": "output_freq",
                    "type": "int",
                    "default": 0,
                    "description": "Frequency in timesteps at which to store the solution"
                },
                {
                    "name": "save_state_freq",
                    "type": "int",
                    "default": 0,
                    "description": "Frequency in timesteps at which to save the state vector"
                },
                {
                    "name": "output_dir",
                    "type": "case-sensitive-str",
                    "default": "results",
                    "description": "Directory where to store all the output"
                },
                {
                    "name": "base_output_file",
                    "type": "case-sensitive-str",
                    "default": "out",
                    "description": "Name of file where to store the solution"
                },
                {
                    "name": "store_total_time",
                    "type": "bool",
                    "default": false,
                    "description": "Whether to output total runtime in seconds to a file"
                },
                {
                    "name": "output_format",
                    "type": "str",
                    "default": "netcdf",
                    "selectables": ["netcdf", "fst"],
                    "description": "Desired format to use for storing simulation results."
                }
            ]
        },
        {
            "name": "Post_processing",
            "fields": [
                {
                    "name": "enable_schar_mountain",
                    "type": "bool",
                    "default": false,
                    "description": "Enable Schar wave mountains to grow (stabilisation issue)"
                },
                {
                    "name": "schar_mountain_longitude",
                    "type": "float",
                    "description": "Mountain longitude center point (radians)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_lattitude",
                    "type": "float",
                    "description": "Mountain latitude center point (radians)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_height",
                    "type": "float",
                    "description": "Peak height of the mountain range (m)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_radius",
                    "type": "float",
                    "description": "Mountain radius (meters)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_length",
                    "type": "float",
                    "description": "Mountain wavelength (meters)",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                },
                {
                    "name": "schar_mountain_step",
                    "type": "int",
                    "min": 0,
                    "default": 0,
                    "description": "Number of step of interpolation, 0 is instantaneous",
                    "dependency": {
                        "name": "enable_schar_mountain",
                        "values": [true]
                    }
                }
            ]
        }
    ]
}
